FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /runner
COPY requirements-ocpp-simulator.txt .
RUN pip install --no-cache-dir -r requirements-ocpp-simulator.txt
COPY scripts/mobilityhouse-fleet.py /runner/mobilityhouse-fleet.py
RUN useradd -r -u 10001 simulator
USER simulator
CMD ["python", "/runner/mobilityhouse-fleet.py"]
